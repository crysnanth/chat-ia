{
  "name": "minichat-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    // 5 perguntas por minuto por endereço ip
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    // 30 perguntars por minuto globalmente
    {
      "name": "GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
